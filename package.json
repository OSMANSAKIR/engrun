{
  "name": "engrun",
  "version": "1.1.0",
  "private": true,
  "description": "Gamified, research-based study app for YDS, e-YDS and YÖKDİL.",
  "license": "MIT",
  "author": "Osman Şakır",
  "repository": "github:OSMANSAKIR/engrun",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "python3 -I tools/validate.py",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
